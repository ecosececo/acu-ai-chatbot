# ── Database ───────────────────────────────
POSTGRES_DB=acu_chatbot
POSTGRES_USER=acu_user
POSTGRES_PASSWORD=acu_secret

# ── Django ─────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── LLM Configuration ─────────────────────
# Local (GPU): LLM_PROVIDER=ollama, LLM_MODEL=qwen3.5
# Cloud (free): LLM_PROVIDER=groq, LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://ollama:11434

# Groq API — required when LLM_PROVIDER=groq (free key: https://console.groq.com)
GROQ_API_KEY=

# ── Redis ──────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scraper Settings ──────────────────────
SCRAPE_DELAY=2.0
SCRAPE_MAX_PAGES=500
